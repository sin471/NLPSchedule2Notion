# このファイルを .env にコピーして値を設定してください（.env は .gitignore 対象）
#   cp .env.example .env

# Notion APIトークン（インテグレーションのシークレット）
NOTION_TOKEN=your_notion_token_here

# 登録先データベースID（学会ごとに分離する場合）
# config.yaml の notion.database_id_env で参照される
NLP_DATABASE_ID=your_nlp_database_id
YANS_DATABASE_ID=your_yans_database_id

# 上記が無い場合のフォールバック
DATABASE_ID=your_default_database_id

# init_db.py でDBを自動作成する際の親ページID（--parent-page 省略時に使用）
NOTION_PARENT_PAGE_ID=your_parent_page_id
